# Number the bot is linked to, digits only with country code (for pairing code login).
# Leave empty to use a QR code instead.
PAIRING_NUMBER=

# Comma-separated owner numbers (digits only). Needed for .autoview / .autolike commands.
# If the bot runs on your own number, your own messages already count as owner.
OWNER_NUMBERS=

PREFIX=.

AUTO_VIEW_STATUS=true
AUTO_LIKE_STATUS=false
STATUS_EMOJI=💚

# false = in groups only react to .dl / .tt / .ig commands
AUTO_IN_GROUPS=false

# Optional proxy for yt-dlp (helps when Instagram blocks AWS IPs), e.g. http://user:pass@host:port
PROXY=
